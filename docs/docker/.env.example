# 复制本文件为 .env 并填写真实配置：cp .env.example .env
# 注意：.env 含敏感信息，已被 .gitignore 忽略，请勿提交到版本库。

MYSQL_ROOT_HOST=%

# 数据/日志持久化目录（Linux 生产环境示例；Windows 本地可改为盘符路径，如 D://var/.oneblog）
ONEBLOG_APP_DIR=/var/.oneblog

# ===== 对外暴露端口 =====
# redis
ONEBLOG_EXPORT_PORT_REDIS=63799
# mysql
ONEBLOG_EXPORT_PORT_MYSQL=33066
# blog-admin，默认为 8085
ONEBLOG_EXPORT_PORT_ADMIN=8085
# blog-web，默认为 8443
ONEBLOG_EXPORT_PORT_WEB=8443

# ===== Redis 配置 =====
ONEBLOG_REDIS_DATABASE_INDEX=1
ONEBLOG_REDIS_HOST=blog-redis
ONEBLOG_REDIS_PORT=6379
# 请修改为强密码
ONEBLOG_REDIS_PASSWORD=change-me-redis-password

# ===== MySQL 配置 =====
ONEBLOG_DATASOURCE_HOST=blog-mysql
ONEBLOG_DATASOURCE_PORT=3306
ONEBLOG_DATASOURCE_DATABASE_NAME=dblog
ONEBLOG_DATASOURCE_USERNAME=root
# 请修改为强密码
ONEBLOG_DATASOURCE_PASSWORD=change-me-mysql-password

# ===== 邮件配置（按需填写）=====
ONEBLOG_MAIL_HOST=
ONEBLOG_MAIL_PORT=465
ONEBLOG_MAIL_USERNAME=
ONEBLOG_MAIL_PASSWORD=

# ===== OneBlog 自定义配置 =====
# 是否启用 kaptcha 验证码
ONEBLOG_APP_ENABLE_KAPTCHA=false
# 是否启用自动校验友情链接的功能
ONEBLOG_APP_ENABLE_CHECK_LINK=false
# 生产环境务必为 false，避免启动时打印数据库连接信息（含密码）
ONEBLOG_APP_ENABLE_PRINT_CONFIG=false
# 是否启用 redis 切面缓存，线上环境建议开启
ONEBLOG_ENABLE_REDIS_CACHE=true
